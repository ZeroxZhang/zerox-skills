# 研究项目含用户资料，应存放在技能包之外。
/workspaces/
/outputs/
/reports/
__pycache__/
*.py[cod]
.DS_Store
.pytest_cache/

# 本目录按可直接安装的技能发布；正式回归测试在仓库 development/，旧本地测试与过程材料不发布。
/tests/
/evals/
/test-results/
/playwright-report/
/debug/
/screenshots/
/audits/
/reviews/
/drafts/
/logs/
/tmp/
/scratch/
*.log
*.tmp
*.bak

# 测试覆盖率及工具缓存。
/.coverage
/.coverage.*
/coverage/
/htmlcov/
.mypy_cache/
.ruff_cache/

# 会话交接与本地预览，不属于技能交付。
/context.md
/.screenshots/

# 台账更新备份是本地恢复材料。
.ledger-backup-*/
