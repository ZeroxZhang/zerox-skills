{
  "version": "1.0.0",
  "description": "统一数据契约；字段验证、枚举、引用、评分与研报类别的唯一机器规则来源。",
  "encoding": {
    "csv": "UTF-8，逗号分隔，标准CSV引号；表头顺序固定；空单元格为null，0不是null。",
    "list": "JSON数组字符串；ids、dates同样编码，禁止逗号或分号拼接。",
    "object": "JSON对象字符串。",
    "bool": "仅true/false小写；JSON布尔值仅用于JSON配置。",
    "date": "YYYY-MM-DD；datetime为带时区ISO 8601。",
    "number": "有限十进制数；禁止bool、NaN和Infinity。",
    "unknown_fields": "拒绝未知列和未知字段，防止拼写错误被忽略。"
  },
  "enums": {
    "purpose": [
      "investment",
      "acquisition",
      "partnership",
      "credit",
      "supplier",
      "competitor"
    ],
    "depth": [
      "Quick",
      "Standard",
      "Deep"
    ],
    "label": [
      "【事实】",
      "【数据】",
      "【推断】",
      "【判断】",
      "【第三方观点】",
      "【待核实】",
      "【缺口】"
    ],
    "confidence": [
      "high",
      "medium",
      "low",
      "unknown"
    ],
    "access": [
      "full_text",
      "partial_text",
      "abstract_only",
      "metadata_only",
      "access_blocked",
      "unreadable"
    ],
    "reading": [
      "unread",
      "partial",
      "analyzed"
    ],
    "gate": [
      "complete",
      "partial",
      "incomplete",
      "not_applicable"
    ],
    "attribute": [
      "actual",
      "forecast",
      "estimate",
      "opinion",
      "not_applicable"
    ],
    "category": [
      "official_annual",
      "official_interim",
      "official_event",
      "company_update",
      "company_deep",
      "industry",
      "event_update",
      "peer"
    ],
    "gap_reason": [
      "not_disclosed",
      "not_found",
      "access_restricted",
      "unreadable",
      "not_executed",
      "not_applicable"
    ],
    "materiality": [
      "critical",
      "major",
      "minor"
    ],
    "scope": [
      "consolidated",
      "standalone",
      "segment",
      "brand",
      "not_applicable"
    ],
    "listing": [
      "listed",
      "unlisted",
      "otc",
      "bond_only",
      "proposed",
      "delisted",
      "unknown"
    ],
    "relation": [
      "control",
      "joint_control",
      "significant_influence",
      "minority",
      "brand_of",
      "branch_of",
      "other"
    ],
    "search_status": [
      "not_executed",
      "found",
      "not_found",
      "access_blocked",
      "failed"
    ],
    "dimension": [
      "business",
      "growth",
      "governance",
      "financial",
      "compliance",
      "technology",
      "operations",
      "deal"
    ]
  },
  "tables": {
    "entity-map": {
      "primary_key": "entity_id",
      "fields": {
        "entity_id": {
          "type": "id",
          "required": true,
          "pattern": "ENT-[0-9]{4,}"
        },
        "legal_name": {
          "type": "string",
          "required": true
        },
        "registration_id": {
          "type": "string",
          "required": false
        },
        "aliases": {
          "type": "list",
          "required": false
        },
        "geography": {
          "type": "string",
          "required": false
        },
        "entity_type": {
          "type": "enum",
          "required": true,
          "values": [
            "legal_entity",
            "group",
            "segment",
            "brand",
            "branch"
          ]
        },
        "identity_status": {
          "type": "enum",
          "required": true,
          "values": [
            "pending",
            "resolved",
            "ambiguous"
          ]
        },
        "listing_status": {
          "type": "enum",
          "required": true,
          "enum": "listing"
        },
        "exchange": {
          "type": "string",
          "required": false
        },
        "security_code": {
          "type": "string",
          "required": false
        },
        "security_class": {
          "type": "string",
          "required": false
        },
        "listing_start": {
          "type": "date",
          "required": false
        },
        "listing_end": {
          "type": "date",
          "required": false
        },
        "evidence_ids": {
          "type": "ids",
          "required": false,
          "ref": "evidence-ledger"
        },
        "identity_notes": {
          "type": "string",
          "required": false
        }
      },
      "conditions": [
        {
          "if": {
            "identity_status": "resolved"
          },
          "required": [
            "registration_id",
            "evidence_ids"
          ]
        },
        {
          "if": {
            "listing_status": "listed"
          },
          "required": [
            "exchange",
            "security_code"
          ]
        }
      ]
    },
    "entity-relations": {
      "primary_key": "relation_id",
      "fields": {
        "relation_id": {
          "type": "id",
          "required": true,
          "pattern": "REL-[0-9]{4,}"
        },
        "parent_id": {
          "type": "id",
