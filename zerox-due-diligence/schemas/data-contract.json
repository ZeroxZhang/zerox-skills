{
  "version": "1.1.0",
  "compatible_versions": [
    "1.0.0"
  ],
  "description": "统一数据契约；字段验证、枚举、引用、评分与研报类别的唯一机器规则来源。",
  "encoding": {
    "csv": "UTF-8，逗号分隔，标准CSV引号；表头顺序固定；空单元格为null，0不是null。",
    "list": "JSON数组字符串；ids、dates同样编码，禁止逗号或分号拼接。",
    "object": "JSON对象字符串。",
    "bool": "仅true/false小写；JSON布尔值仅用于JSON配置。",
    "date": "YYYY-MM-DD；datetime为带时区ISO 8601。",
    "number": "有限十进制数；禁止bool、NaN和Infinity。",
    "unknown_fields": "拒绝未知列和未知字段，防止拼写错误被忽略。"
  },
  "enums": {
    "purpose": [
      "company_research",
      "investment",
      "acquisition",
      "partnership",
      "credit",
      "supplier",
      "competitor"
    ],
    "depth": [
      "Quick",
      "Standard",
      "Deep"
    ],
    "label": [
      "【事实】",
      "【数据】",
      "【推断】",
      "【判断】",
      "【第三方观点】",
      "【待核实】",
      "【缺口】"
    ],
    "confidence": [
      "high",
      "medium",
      "low",
      "unknown"
    ],
    "access": [
      "full_text",
      "partial_text",
      "abstract_only",
      "metadata_only",
      "access_blocked",
      "unreadable"
    ],
    "reading": [
      "unread",
      "partial",
      "analyzed"
    ],
    "gate": [
      "complete",
      "partial",
      "incomplete",
      "not_applicable"
    ],
    "attribute": [
      "actual",
      "forecast",
      "estimate",
      "opinion",
      "not_applicable"
    ],
    "category": [
      "official_annual",
      "official_interim",
      "official_event",
      "company_update",
      "company_deep",
      "industry",
      "event_update",
      "peer"
    ],
    "gap_reason": [
      "not_disclosed",
      "not_found",
      "access_restricted",
      "unreadable",
      "not_executed",
      "not_applicable"
    ],
    "materiality": [
      "critical",
      "major",
      "minor"
    ],
    "scope": [
      "consolidated",
      "standalone",
      "segment",
      "brand",
      "not_applicable"
    ],
    "listing": [
      "listed",
      "unlisted",
      "otc",
      "bond_only",
      "proposed",
      "delisted",
      "unknown"
    ],
    "relation": [
      "control",
      "joint_control",
      "significant_influence",
      "minority",
      "brand_of",
      "trademark_holder",
      "operator",
      "licensee",
      "manufacturer",
      "distributor",
      "branch_of",
      "other"
    ],
    "search_status": [
      "not_executed",
      "found",
      "not_found",
      "access_blocked",
      "failed"
    ],
    "dimension": [
      "business",
      "growth",
      "governance",
      "financial",
      "compliance",
      "technology",
      "operations",
      "deal"
    ],
    "gap_disposition": [
      "non_blocking",
      "limits_conclusion",
      "blocks_completion"
    ]
  },
  "tables": {
    "entity-map": {
      "primary_key": "entity_id",
      "fields": {
        "entity_id": {
          "type": "id",
          "required": true,
          "pattern": "ENT-[0-9]{4,}"
        },
        "legal_name": {
          "type": "string",
          "required": true
        },
        "registration_id": {
          "type": "string",
          "required": false,
          "description": "非自然人按身份类型填写可核验登记号；person 留空，不收私人证件号。"
        },
        "aliases": {
          "type": "list",
          "required": false
        },
        "geography": {
          "type": "string",
          "required": false
        },
        "entity_type": {
          "type": "enum",
          "required": true,
          "values": [
            "legal_entity",
            "group",
            "segment",
            "brand",
            "branch",
            "person"
          ],
          "description": "person 仅为商标权利人、股东或实际控制人等关联角色，不能作为研究目标、上市主体或公司营业数据主体。"
        },
        "identity_status": {
          "type": "enum",
          "required": true,
          "values": [
            "pending",
            "resolved",
            "ambiguous"
          ]
        },
        "listing_status": {
          "type": "enum",
          "required": true,
          "enum": "listing"
        },
        "exchange": {
          "type": "string",
          "required": false
        },
        "security_code": {
          "type": "string",
          "required": false
        },
        "security_class": {
          "type": "string",
          "required": false
        },
        "listing_start": {
          "type": "date",
          "required": false
        },
        "listing_end": {
          "type": "date",
          "required": false
        },
        "evidence_ids": {
          "type": "ids",
          "required": false,
          "ref": "evidence-ledger"
        },
        "identity_notes": {
          "type": "string",
          "required": false
        }
      },
      "conditions": [
        {
          "if": {
            "identity_status": "resolved"
          },
          "required": [
            "evidence_ids"
          ]
        },
        {
          "if": {
            "listing_status": "listed"
          },
          "required": [
            "exchange",
            "security_code"
          ]
        },
        {
          "if": {
            "identity_status": "resolved",
            "entity_type": "legal_entity"
          },
          "required": [
            "registration_id"
          ]
        },
        {
          "if": {
            "identity_status": "resolved",
            "entity_type": "group"
          },
          "required": [
            "registration_id"
          ]
        },
        {
          "if": {
            "identity_status": "resolved",
            "entity_type": "segment"
          },
          "required": [
            "registration_id"
          ]
        },
        {
          "if": {
            "identity_status": "resolved",
            "entity_type": "brand"
          },
          "required": [
            "registration_id"
          ]
        },
        {
          "if": {
            "identity_status": "resolved",
            "entity_type": "branch"
          },
          "required": [
            "registration_id"
          ]
        },
        {
          "if": {
            "identity_status": "resolved",
            "entity_type": "person"
          },
          "required": [
            "identity_notes"
          ]
        }
      ]
    },
    "entity-relations": {
      "primary_key": "relation_id",
      "fields": {
        "relation_id": {
          "type": "id",
          "required": true,
          "pattern": "REL-[0-9]{4,}"
        },
        "parent_id": {
          "type": "id",
          "required": true,
          "ref": "entity-map"
        },
        "child_id": {
          "type": "id",
          "required": true,
          "ref": "entity-map"
        },
        "relation_type": {
          "type": "enum",
          "required": true,
          "enum": "relation"
        },
        "ownership_percent": {
          "type": "number",
          "required": false,
          "minimum": 0,
          "maximum": 100
        },
        "control_basis": {
          "type": "string",
          "required": true
        },
        "effective_from": {
          "type": "date",
          "required": false,
          "description": "待核实线索可留空，不猜生效日；verification=verified 时必须提供。未知起日的 pending 边保留为潜在关系，不能确认控制或品牌经营主体。"
        },
        "effective_to": {
          "type": "date",
          "required": false
        },
        "state": {
          "type": "enum",
          "required": true,
          "values": [
            "current",
            "historical",
            "proposed"
          ]
        },
        "verification": {
          "type": "enum",
          "required": true,
          "values": [
            "pending",
            "verified"
          ]
        },
        "evidence_ids": {
          "type": "ids",
          "required": false,
          "ref": "evidence-ledger"
        }
      },
      "conditions": [
        {
          "if": {
            "verification": "verified"
          },
          "required": [
            "evidence_ids",
            "effective_from"
          ]
        }
      ]
    },
    "search-log": {
      "primary_key": "search_id",
      "fields": {
        "search_id": {
          "type": "id",
          "required": true,
          "pattern": "Q-[0-9]{4,}"
        },
        "searched_at": {
          "type": "datetime",
          "required": true
        },
        "channel": {
          "type": "string",
          "required": true
        },
        "query": {
          "type": "string",
          "required": true
        },
        "entity_id": {
          "type": "id",
          "required": true,
          "ref": "entity-map"
        },
        "period_start": {
          "type": "date",
          "required": false
        },
        "period_end": {
          "type": "date",
          "required": false
        },
        "purpose": {
          "type": "string",
          "required": true
        },
        "status": {
          "type": "enum",
          "required": true,
          "enum": "search_status"
        },
        "source_ids": {
          "type": "ids",
          "required": false,
          "ref": "source-register"
        },
        "limitations": {
          "type": "string",
          "required": false
        }
      },
      "conditions": []
    },
    "source-register": {
      "primary_key": "source_id",
      "fields": {
        "source_id": {
          "type": "id",
          "required": true,
          "pattern": "S-[0-9]{4,}"
        },
        "title": {
          "type": "string",
          "required": true
        },
        "source_type": {
          "type": "enum",
          "required": true,
          "values": [
            "official",
            "broker",
            "rating",
            "database",
            "company",
            "media",
            "interview",
            "other"
          ]
        },
        "publisher": {
          "type": "string",
          "required": true
        },
        "author": {
          "type": "string",
          "required": false
        },
        "published_date": {
          "type": "date",
          "required": false,
          "description": "原件未载明时留空；必须用 grade_reason 说明缺日期与时点可用性，不能用访问日期代替。"
        },
        "revised_date": {
          "type": "date",
          "required": false
        },
        "accessed_date": {
          "type": "date",
          "required": true
        },
        "locator": {
          "type": "string",
          "required": true
        },
        "grade": {
          "type": "enum",
          "required": true,
          "values": [
            "S",
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "grade_reason": {
          "type": "string",
          "required": false,
          "description": "来源评级与可用性说明；发布日期未知时必填，说明缺日期及研究时点限制。"
        },
        "origin_group": {
          "type": "string",
          "required": true
        },
        "upstream_source_id": {
          "type": "id",
          "required": false,
          "ref": "source-register"
        },
        "access_status": {
          "type": "enum",
          "required": true,
          "enum": "access"
        },
        "authenticity": {
          "type": "enum",
          "required": true,
          "values": [
            "checked",
            "pending",
            "uncertain"
          ]
        },
        "authorization": {
          "type": "string",
          "required": true
        },
        "time_scope": {
          "type": "enum",
          "required": true,
          "values": [
            "as_of",
            "retrospective"
          ]
        },
        "checksum": {
          "type": "string",
          "required": false
        }
      },
      "conditions": [
        {
          "if": {
            "published_date": null
          },
          "required": [
            "grade_reason"
          ]
        }
      ]
    },
    "evidence-ledger": {
      "primary_key": "evidence_id",
      "fields": {
        "evidence_id": {
          "type": "id",
          "required": true,
          "pattern": "E-[0-9]{4,}"
        },
        "source_id": {
          "type": "id",
          "required": true,
          "ref": "source-register"
        },
        "entity_id": {
          "type": "id",
          "required": true,
          "ref": "entity-map"
        },
        "module": {
          "type": "module",
          "required": true
        },
        "locator": {
          "type": "string",
          "required": true
        },
        "excerpt": {
          "type": "string",
          "required": true
        },
        "period_start": {
          "type": "date",
          "required": false
        },
        "period_end": {
          "type": "date",
          "required": false
        },
        "geography": {
          "type": "string",
          "required": false
        },
        "currency": {
          "type": "string",
          "required": false
        },
        "unit": {
          "type": "string",
          "required": false
        },
        "accounting_basis": {
          "type": "string",
          "required": false
        },
        "scope": {
          "type": "enum",
          "required": true,
          "enum": "scope"
        },
        "attribute": {
          "type": "enum",
          "required": true,
          "enum": "attribute"
        },
        "numeric": {
          "type": "bool",
          "required": true
        },
        "value": {
          "type": "number",
          "required": false
        },
        "limitations": {
          "type": "string",
          "required": false
        }
      },
      "conditions": [
        {
          "if": {
            "numeric": "true"
          },
          "required": [
            "period_start",
            "period_end",
            "geography",
            "currency",
            "unit",
            "accounting_basis",
            "value"
          ]
        }
      ]
    },
    "claim-register": {
      "primary_key": "claim_id",
      "fields": {
        "claim_id": {
          "type": "id",
          "required": true,
          "pattern": "C-[0-9]{4,}"
        },
        "statement": {
          "type": "string",
          "required": true
        },
        "label": {
          "type": "enum",
          "required": true,
          "enum": "label"
        },
        "entity_id": {
          "type": "id",
          "required": true,
          "ref": "entity-map"
        },
        "module": {
          "type": "module",
          "required": true
        },
        "materiality": {
          "type": "enum",
          "required": true,
          "enum": "materiality"
        },
        "verification": {
          "type": "enum",
          "required": true,
          "values": [
            "pending",
            "verified",
            "disputed",
            "unsupported",
            "refuted"
          ]
        },
        "confidence": {
          "type": "enum",
          "required": true,
          "enum": "confidence"
        },
        "attribute": {
          "type": "enum",
          "required": true,
          "enum": "attribute"
        },
        "numeric": {
          "type": "bool",
          "required": true
        },
        "scope": {
          "type": "enum",
          "required": true,
          "enum": "scope"
        },
        "assumptions": {
          "type": "string",
          "required": false
        },
        "counterevidence": {
          "type": "string",
          "required": false
        },
        "unresolved": {
          "type": "string",
          "required": false
        }
      },
      "conditions": [
        {
          "if": {
            "label": "【推断】"
          },
          "required": [
            "assumptions"
          ]
        },
        {
          "if": {
            "label": "【判断】"
          },
          "required": [
            "assumptions"
          ]
        },
        {
          "if": {
            "verification": "refuted"
          },
          "required": [
            "counterevidence"
          ]
        }
      ]
    },
    "claim-evidence": {
      "primary_key": "link_id",
      "fields": {
        "link_id": {
          "type": "id",
          "required": true,
          "pattern": "CE-[0-9]{4,}"
        },
        "claim_id": {
          "type": "id",
          "required": true,
          "ref": "claim-register"
        },
        "evidence_id": {
          "type": "id",
          "required": true,
          "ref": "evidence-ledger"
        },
        "relation": {
          "type": "enum",
          "required": true,
          "values": [
            "supports",
            "contradicts",
            "context"
          ]
        },
        "applicable_scope": {
          "type": "string",
          "required": true
        },
        "bridge": {
          "type": "string",
          "required": false
        },
        "limitations": {
          "type": "string",
          "required": false
        }
      },
      "conditions": []
    },
    "research-register": {
      "primary_key": "research_id",
      "fields": {
        "research_id": {
          "type": "id",
          "required": true,
          "pattern": "R-[0-9]{4,}"
        },
        "source_id": {
          "type": "id",
          "required": true,
          "ref": "source-register"
        },
        "publisher": {
          "type": "string",
          "required": true
        },
        "author": {
          "type": "string",
          "required": false
        },
        "title": {
          "type": "string",
          "required": true
        },
        "categories": {
          "type": "list",
          "required": true,
          "item_enum": "category"
        },
        "category_relevance": {
          "type": "object",
          "required": true
        },
        "target_id": {
          "type": "id",
          "required": true,
          "ref": "entity-map"
        },
        "coverage_entity_id": {
          "type": "id",
          "required": true,
          "ref": "entity-map"
        },
        "security_code": {
          "type": "string",
          "required": false
        },
        "report_date": {
          "type": "date",
          "required": true
        },
        "version": {
          "type": "string",
          "required": true
        },
        "supersedes_id": {
          "type": "id",
          "required": false,
          "ref": "research-register"
        },
        "data_cutoff": {
          "type": "date",
          "required": false
        },
        "forecast_periods": {
          "type": "list",
          "required": false
        },
        "valuation_date": {
          "type": "date",
          "required": false
        },
        "access_status": {
          "type": "enum",
          "required": true,
          "enum": "access"
        },
        "reading_status": {
          "type": "enum",
          "required": true,
          "enum": "reading"
        },
        "relevant_sections": {
          "type": "string",
          "required": false
        },
        "interests": {
          "type": "string",
          "required": false
        },
        "key_views": {
          "type": "string",
          "required": false
        },
        "assumptions": {
          "type": "string",
          "required": false
        },
        "forecast_changes": {
          "type": "string",
          "required": false
        },
        "valuation": {
          "type": "string",
          "required": false
        },
        "risks": {
          "type": "string",
          "required": false
        },
        "decision_impact": {
          "type": "string",
          "required": false
        },
        "event_dates": {
          "type": "dates",
          "required": false
        },
        "relevance": {
          "type": "enum",
          "required": true,
          "values": [
            "direct",
            "limited",
            "excluded"
          ]
        },
        "exclusion_reason": {
          "type": "string",
          "required": false
        },
        "limitations": {
          "type": "string",
          "required": false
        },
        "latest_discovered_for": {
          "type": "ids",
          "required": false,
          "ref": "research-coverage"
        },
        "latest_fulltext_for": {
          "type": "ids",
          "required": false,
          "ref": "research-coverage"
        },
        "latest_read_for": {
          "type": "ids",
          "required": false,
          "ref": "research-coverage"
        }
      },
      "conditions": [
        {
          "if": {
            "reading_status": "analyzed"
          },
          "required": [
            "relevant_sections",
            "interests",
            "key_views",
            "assumptions",
            "risks",
            "decision_impact"
          ]
        },
        {
          "if": {
            "relevance": "excluded"
          },
          "required": [
            "exclusion_reason"
          ]
        }
      ]
    },
    "research-coverage": {
      "primary_key": "coverage_id",
      "fields": {
        "coverage_id": {
          "type": "id",
          "required": true,
          "pattern": "RC-[0-9]{4,}"
        },
        "target_id": {
          "type": "id",
          "required": true,
          "ref": "entity-map"
        },
        "research_entity_id": {
          "type": "id",
          "required": true,
          "ref": "entity-map"
        },
        "category": {
          "type": "enum",
          "required": true,
          "enum": "category"
        },
        "required": {
          "type": "bool",
          "required": true
        },
        "reason": {
          "type": "string",
          "required": true
        },
        "search_status": {
          "type": "enum",
          "required": true,
          "enum": "search_status"
        },
        "search_ids": {
          "type": "ids",
          "required": false,
          "ref": "search-log"
        },
        "latest_discovered_id": {
          "type": "id",
          "required": false,
          "ref": "research-register"
        },
        "latest_fulltext_id": {
          "type": "id",
          "required": false,
          "ref": "research-register"
        },
        "latest_read_id": {
          "type": "id",
          "required": false,
          "ref": "research-register"
        },
        "latestness_checked_at": {
          "type": "datetime",
          "required": false
        },
        "event_dates": {
          "type": "dates",
          "required": false
        },
        "event_coverage": {
          "type": "enum",
          "required": true,
          "values": [
            "pending",
            "covered",
            "lagging",
            "not_applicable"
          ]
        },
        "gate_status": {
          "type": "enum",
          "required": true,
          "enum": "gate"
        },
        "gap_id": {
          "type": "id",
          "required": false,
          "ref": "gap-register"
        },
        "limitations": {
          "type": "string",
          "required": false
