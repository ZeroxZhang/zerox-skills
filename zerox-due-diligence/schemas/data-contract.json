          "type": "enum",
          "required": true,
          "enum": "relation"
        },
        "ownership_percent": {
          "type": "number",
          "required": false,
          "minimum": 0,
          "maximum": 100
        },
        "control_basis": {
          "type": "string",
          "required": true
        },
        "effective_from": {
          "type": "date",
          "required": true
        },
        "effective_to": {
          "type": "date",
          "required": false
        },
        "state": {
          "type": "enum",
          "required": true,
          "values": [
            "current",
            "historical",
            "proposed"
          ]
        },
        "verification": {
          "type": "enum",
          "required": true,
          "values": [
            "pending",
            "verified"
          ]
        },
        "evidence_ids": {
          "type": "ids",
          "required": false,
          "ref": "evidence-ledger"
        }
      },
      "conditions": [
        {
          "if": {
            "verification": "verified"
          },
          "required": [
            "evidence_ids"
          ]
        }
      ]
    },
