{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeroxZhang/zerox-skills/blob/main/zerox-onepager/references/manifest-schema.json",
  "title": "Onepager Project Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "paths",
    "builds"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "created_at", "updated_at"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "blueprint", "ir", "builds"],
      "properties": {
        "source": {"type": "string"},
        "blueprint": {"type": "string"},
        "ir": {"type": "string"},
        "builds": {"type": "string"}
      }
    },
    "builds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "created_at",
          "tool",
          "configuration",
          "artifacts",
          "checks"
        ],
        "properties": {
          "version": {"type": "string", "pattern": "^v[0-9]{3}$"},
          "created_at": {"type": "string", "format": "date-time"},
          "tool": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"enum": ["onepager", "zerox-onepager"]},
              "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
            }
          },
          "configuration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["A", "B", "C", "T", "E", "F"],
            "properties": {
              "A": {"enum": ["A1", "A2", "A3", "A4"]},
              "B": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "B9"]},
              "C": {"enum": ["C1", "C2", "C3"]},
              "T": {"enum": ["T1", "T2", "T3", "T4"]},
              "E": {"enum": ["E1", "E2"]},
              "F": {"type": "string", "minLength": 1}
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "sha256", "bytes"],
              "properties": {
                "kind": {
                  "enum": ["html", "png", "svg", "pdf", "ir", "source"]
                },
                "path": {"type": "string", "minLength": 1},
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {"type": "integer", "minimum": 0}
              }
            }
          },
          "checks": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "verdict", "sha256"],
              "properties": {
                "kind": {"enum": ["static", "render"]},
                "path": {"type": "string", "minLength": 1},
                "verdict": {"const": "PASS"},
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
