{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeroxZhang/zerox-skills/blob/main/zerox-onepager/references/onepager-ir-schema.json",
  "title": "Onepager IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "blueprint",
    "configuration",
    "modules",
    "design_intent"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "created_at"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "blueprint": {"$ref": "./blueprint-schema.json"},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "T", "E", "F"],
      "properties": {
        "A": {"enum": ["A1", "A2", "A3", "A4"]},
        "B": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "B9"]},
        "B_mode": {"enum": ["Light", "Dark", "Poster"]},
        "C": {"enum": ["C1", "C2", "C3"]},
        "T": {"enum": ["T1", "T2", "T3", "T4"]},
        "focus": {"enum": ["product", "solution", "steps", "spec"]},
        "E": {"enum": ["E1", "E2"]},
        "F": {"type": "string", "minLength": 1}
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "content",
          "source_refs",
          "visual_priority",
          "locked"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "role": {"type": "string", "minLength": 1},
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": {
              "title": {"type": "string"},
              "body": {"type": "string"},
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "label", "source_ref"],
                  "properties": {
                    "value": {"type": ["number", "string"]},
                    "unit": {"type": "string"},
                    "label": {"type": "string", "minLength": 1},
                    "source_ref": {"type": "string", "minLength": 1},
                    "assumption": {"type": "boolean", "default": false}
                  }
                }
              }
            }
          },
          "source_refs": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "visual_priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "diagram": {
            "type": ["string", "null"],
            "enum": [
              "flow",
              "tree",
              "architecture",
              "matrix",
              "comparison",
              "radar",
              "pie",
              "bar",
              "line",
              null
            ]
          },
          "locked": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content", "layout"],
            "properties": {
              "content": {"type": "boolean"},
              "layout": {"type": "boolean"}
            }
          }
        }
      }
    },
    "design_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_language", "color_role", "type_ratio"],
      "properties": {
        "visual_language": {
          "enum": ["border-rhythm", "color-blocks", "typography-driven"]
        },
        "color_role": {"enum": ["spice", "main"]},
        "type_ratio": {"type": "number", "minimum": 3}
      }
    },
    "brand_ref": {"type": ["string", "null"]}
  }
}
